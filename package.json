{
  "name": "my-blog",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:upgrade": "prisma db execute --file prisma/upgrade-collaboration.sql --schema prisma/schema.prisma && npm run db:upgrade:birthday && npm run db:upgrade:google",
    "db:claim-legacy": "node --env-file=.env --import tsx scripts/claim-legacy-posts.ts",
    "db:init": "prisma db push",
    "db:cleanup": "node --env-file=.env --import tsx scripts/cleanup.ts",
    "db:upgrade:birthday": "prisma db execute --file prisma/upgrade-birthday-age.sql --schema prisma/schema.prisma",
    "db:upgrade:google": "prisma db execute --file prisma/upgrade-google-login.sql --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@vercel/blob": "^0.27.1",
    "jose": "^6.1.0",
    "next": "15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "@types/node": "^20.16.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
